        <mxCell id="n165" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;fontColor=#16324F;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacing=8;dashed=0;strokeWidth=1.5;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="1370" width="1450" height="126" as="geometry"/></mxCell>
        <mxCell id="n166" value="NOTAS IMPORTANTES" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#16324F;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1376" width="300" height="22" as="geometry"/></mxCell>
        <mxCell id="n167" value="&lt;b&gt;Escalabilidad:&lt;/b&gt; Lambda escala por solicitud; HPA de 2 a 5 réplicas por Deployment al 70 % de CPU; Node Group de 2 a 4 nodos." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#16324F;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="1402" width="690" height="30" as="geometry"/></mxCell>
        <mxCell id="n168" value="&lt;b&gt;Desacoplamiento:&lt;/b&gt; SQS separa la respuesta al cliente del registro en RDS; tras 3 intentos fallidos el mensaje pasa a la DLQ." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#16324F;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="1432" width="690" height="30" as="geometry"/></mxCell>
        <mxCell id="n169" value="&lt;b&gt;Seguridad:&lt;/b&gt; SG encadenados por capa, RDS solo en subredes DATA, DynamoDB por VPC Endpoint, todo cifrado en reposo." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#16324F;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="1462" width="690" height="30" as="geometry"/></mxCell>
        <mxCell id="n170" value="&lt;b&gt;Alta disponibilidad:&lt;/b&gt; ALB, nodos EKS y RDS en 2 AZ. El NAT es único (1a) por costo: si cae la AZ1a, APP 1b pierde la salida a Internet." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#16324F;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="1402" width="690" height="30" as="geometry"/></mxCell>
        <mxCell id="n171" value="&lt;b&gt;Lambda y la VPC:&lt;/b&gt; solo Process-Order se conecta a la VPC (necesita RDS); Cart y Create-Order usan DynamoDB y SQS desde fuera." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#16324F;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="1432" width="690" height="30" as="geometry"/></mxCell>
        <mxCell id="n172" value="&lt;b&gt;API Gateway → ALB:&lt;/b&gt; integración HTTP 80 por Internet (el lab no tiene certificado ACM); mejora propuesta: VPC Link con NLB." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#16324F;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="760" y="1462" width="690" height="30" as="geometry"/></mxCell>
