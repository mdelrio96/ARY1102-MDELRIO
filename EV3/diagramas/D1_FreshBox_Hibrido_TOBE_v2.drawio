        <mxCell id="n251" value="&lt;b&gt;Carrito&lt;/b&gt;&lt;br&gt;S3 → API Gateway → Lambda Cart → DynamoDB (el ítem expira a las 24 h por TTL)" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#16324F;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1546" y="1126" width="424" height="58" as="geometry"/></mxCell>
