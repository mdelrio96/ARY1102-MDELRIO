        <mxCell id="n245" value="&lt;b&gt;Soporte&lt;/b&gt; (imágenes y salida a Internet)&lt;br&gt;Ej: ECR → nodos EKS · nodos APP → NAT" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#16324F;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1620" y="960" width="350" height="36" as="geometry"/></mxCell>
