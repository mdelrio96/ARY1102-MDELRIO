        <mxCell id="n243" value="&lt;b&gt;Flujo asíncrono&lt;/b&gt; (desacoplado)&lt;br&gt;Ej: Create-Order → SQS → Process-Order" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#16324F;align=left;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1620" y="922" width="350" height="36" as="geometry"/></mxCell>
